<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="950.0" styleClass="root-paper" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MainController">
   <top>
      <VBox spacing="12.0" styleClass="masthead" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="24.0" right="24.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Label styleClass="masthead-title" text="QUOTER" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleNewEntry" styleClass="primary-btn" text="New entry" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="nav-bar">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleLibrary" styleClass="nav-tab" text="Library" />
                  <Button disable="true" mnemonicParsing="false" styleClass="nav-tab" text="Bookshelf" />
                  <Button disable="true" mnemonicParsing="false" styleClass="nav-tab" text="Daily review" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <StackPane fx:id="pageContainer" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>