<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="650.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="14.0" styleClass="paper-sheet" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" VBox.vgrow="ALWAYS">
         <children>
            <Label styleClass="sheet-heading" text="New Entry" />
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="backButton" mnemonicParsing="false" styleClass="nav-tab" text="Back" />
         </children>
      </HBox>
      <Label styleClass="field-label" text="QUOTE" />
      <TextArea fx:id="quoteInput" prefHeight="200.0" prefRowCount="4" prefWidth="200.0" styleClass="hairline-input" wrapText="true" />
      <Label text="BOOK" />
      <TextField fx:id="bookInput" styleClass="hairline-input" />
      <Label text="AUTHOR" />
      <TextField fx:id="authorInput" styleClass="hairline-input" />
      <Label text="CATEGORY" />
      <ComboBox fx:id="categoryInput" editable="true" prefWidth="150.0" />
      <HBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="12.0">
         <children>
            <Button mnemonicParsing="false" styleClass="secondary-btn" text="Cancel" />
            <Button mnemonicParsing="false" styleClass="primary-btn" text="Save to Bookshelf" />
         </children>
      </HBox>
   </children>
</VBox>
