<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LibraryController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <TextField fx:id="searchField" promptText="Search quotes, books, or authors..." styleClass="hairline-input" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="categoryFilter" prefWidth="170.0" promptText="All Categories" styleClass="hairline-input" />
         </children>
      </HBox>
      <ScrollPane fitToWidth="true" styleClass="broadsheet-scroll" VBox.vgrow="ALWAYS">
         <content>
            <FlowPane fx:id="quotesContainer" hgap="20.0" styleClass="quotes-grid" vgap="20.0" />
         </content>
      </ScrollPane>
   </children>
</VBox>